#!/usr/bin/env bash
#
# Test runner for /mind/rules/query
#
set -e

BRANE_ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
source "$BRANE_ROOT/tests/lib.sh"

INPUT=$(cat)
workspace

create_claim() {
  echo "$1" | brane /mind/claims/create > /dev/null 2>&1
}

case "$TC_CASE_NAME" in
  00-success-cycles-found)
    init_mind
    # Create cycle A -> B -> C -> A
    create_concepts '[{"name": "A", "type": "Entity"}, {"name": "B", "type": "Entity"}, {"name": "C", "type": "Entity"}]'
    create_edges '[{"source": 1, "target": 2, "relation": "DEPENDS_ON"}, {"source": 2, "target": 3, "relation": "DEPENDS_ON"}, {"source": 3, "target": 1, "relation": "DEPENDS_ON"}]'
    ;;
  01-success-cycles-none)
    init_mind
    # Create chain without cycle A -> B -> C
    create_concepts '[{"name": "A", "type": "Entity"}, {"name": "B", "type": "Entity"}, {"name": "C", "type": "Entity"}]'
    create_edges '[{"source": 1, "target": 2, "relation": "DEPENDS_ON"}, {"source": 2, "target": 3, "relation": "DEPENDS_ON"}]'
    ;;
  02-success-orphans-found)
    init_mind
    # Create connected and orphan concepts
    create_concepts '[{"name": "Connected", "type": "Entity"}, {"name": "Orphan", "type": "Entity"}]'
    create_edges '[{"source": 1, "target": 1, "relation": "DEPENDS_ON"}]'
    ;;
  03-success-orphans-none)
    init_mind
    # All concepts connected
    create_concepts '[{"name": "A", "type": "Entity"}, {"name": "B", "type": "Entity"}]'
    create_edges '[{"source": 1, "target": 2, "relation": "DEPENDS_ON"}]'
    ;;
  04-success-custom-rule)
    init_mind
    # Create a custom rule and query it
    echo '{"name": "all_entities", "description": "All Entity concepts", "body": "all_entities[id, name] := *concepts[id, name, \"Entity\", _, _]"}' | brane /mind/rules/create > /dev/null 2>&1
    create_concepts '[{"name": "Service", "type": "Entity"}, {"name": "Warning", "type": "Caveat"}]'
    ;;
  05-error-not-found)
    init_mind
    ;;
  06-success-cycles-self-loop)
    init_mind
    # Self-loop: A -> A
    create_concepts '[{"name": "SelfRef", "type": "Entity"}]'
    create_edges '[{"source": 1, "target": 1, "relation": "DEPENDS_ON"}]'
    ;;
  07-success-cycles-multiple)
    init_mind
    # Two independent cycles: A -> B -> A, C -> D -> C
    create_concepts '[{"name": "A", "type": "Entity"}, {"name": "B", "type": "Entity"}, {"name": "C", "type": "Entity"}, {"name": "D", "type": "Entity"}]'
    create_edges '[{"source": 1, "target": 2, "relation": "DEPENDS_ON"}, {"source": 2, "target": 1, "relation": "DEPENDS_ON"}, {"source": 3, "target": 4, "relation": "DEPENDS_ON"}, {"source": 4, "target": 3, "relation": "DEPENDS_ON"}]'
    ;;
  08-error-not-initialized)
    # Initialize body but not mind
    init_body
    ;;
  09-success-orphans-self-edge)
    init_mind
    # Concept with only self-edge (not an orphan)
    create_concepts '[{"name": "SelfOnly", "type": "Entity"}, {"name": "RealOrphan", "type": "Entity"}]'
    create_edges '[{"source": 1, "target": 1, "relation": "DEPENDS_ON"}]'
    ;;
  # Built-in contradictions rule: concept 1 carries competing refund claims.
  10-success-contradictions-found)
    init_mind
    create_concepts '[{"name": "RefundWindow", "type": "Entity"}, {"name": "Quiet", "type": "Entity"}]'
    create_claim '{"subject_type":"concept","subject_id":1,"predicate":"refund_window","assertion":"30 days","authority":"product","source":"prd.md"}'
    create_claim '{"subject_type":"concept","subject_id":1,"predicate":"refund_window","assertion":"14 days","authority":"legal","source":"policy.md"}'
    ;;
  # Two authorities asserting the same thing is agreement, not contradiction.
  11-success-contradictions-none)
    init_mind
    create_concepts '[{"name": "Palette", "type": "Entity"}]'
    create_claim '{"subject_type":"concept","subject_id":1,"predicate":"color","assertion":"blue","authority":"product","source":"a.md"}'
    create_claim '{"subject_type":"concept","subject_id":1,"predicate":"color","assertion":"blue","authority":"legal","source":"b.md"}'
    ;;
  # User-defined rules can join claims and authority rank.
  12-success-custom-rule-joins-claims)
    init_mind
    create_concepts '[{"name": "RefundWindow", "type": "Entity"}, {"name": "Casual", "type": "Entity"}]'
    create_claim '{"subject_type":"concept","subject_id":1,"predicate":"refund_window","assertion":"14 days","authority":"legal","source":"policy.md"}'
    create_claim '{"subject_type":"concept","subject_id":2,"predicate":"note","assertion":"whatever","authority":"observation","source":"session"}'
    echo '{"name": "high_authority", "description": "Concepts carrying a claim at rank 40 or above", "body": "high_authority[id, name] := *concepts[id, name, _, _, _], *claims[_, '"'"'concept'"'"', id, _, _, auth, _, _], *authorities[auth, rank, _], rank >= 40"}' | brane /mind/rules/create > /dev/null 2>&1
    ;;
esac

echo "$INPUT" | brane /mind/rules/query
