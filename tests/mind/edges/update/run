#!/usr/bin/env bash
#
# Test runner for /mind/edges/update
#
set -e

BRANE_ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
source "$BRANE_ROOT/tests/lib.sh"

INPUT=$(cat)
workspace

case "$TC_CASE_NAME" in
  00-success-update-relation)
    init_mind
    create_concepts '[{"name": "A", "type": "Entity"}, {"name": "B", "type": "Entity"}]'
    create_edges '[{"source": 1, "target": 2, "relation": "DEPENDS_ON"}]'
    ;;
  01-success-update-weight)
    init_mind
    create_concepts '[{"name": "A", "type": "Entity"}, {"name": "B", "type": "Entity"}]'
    create_edges '[{"source": 1, "target": 2, "relation": "DEPENDS_ON"}]'
    ;;
  02-error-not-found)
    init_mind
    ;;
  03-error-missing-id)
    init_mind
    ;;
  04-success-custom-relation)
    init_mind
    create_concepts '[{"name": "A", "type": "Entity"}, {"name": "B", "type": "Entity"}]'
    create_edges '[{"source": 1, "target": 2, "relation": "DEPENDS_ON"}]'
    ;;
  # #129: same all-key defect on edges.
  05-success-update-relation-does-not-duplicate)
    init_mind
    create_concepts '[{"name": "A", "type": "Entity"}, {"name": "B", "type": "Entity"}]'
    create_edges '[{"source": 1, "target": 2, "relation": "DEPENDS_ON"}]'
    echo '{"id": 1, "relation": "CONFLICTS_WITH"}' | brane /mind/edges/update > /dev/null 2>&1
    echo "$INPUT" | brane /mind/edges/list
    exit 0
    ;;

  06-success-update-weight-does-not-duplicate)
    init_mind
    create_concepts '[{"name": "A", "type": "Entity"}, {"name": "B", "type": "Entity"}]'
    create_edges '[{"source": 1, "target": 2, "relation": "DEPENDS_ON"}]'
    echo '{"id": 1, "weight": 0.5}' | brane /mind/edges/update > /dev/null 2>&1
    echo "$INPUT" | brane /mind/edges/list
    exit 0
    ;;
esac

echo "$INPUT" | brane /mind/edges/update
